Vagrant.configure("2") do |config|
  config.vm.box = "generic/alpine318"
  config.vm.synced_folder "./confs" , "/confs_data"
  
  config.vm.define "ccurS" do |ccurS|
    ccurS.vm.network "private_network", ip: "192.168.56.110", libvirt__forward_mode: "nat"
    
    ccurS.vm.network "forwarded_port", guest: 80, host: 9090
    ccurS.vm.hostname = "ccurS"

    ccurS.vm.provider "libvirt" do |lv|
      lv.memory = 2048
      lv.cpus = 2
      lv.graphics_type = "spice"
      lv.nic_model_type = "virtio"
    end
    
    ccurS.vm.provision "shell", path: "./scripts/server_init.sh"
  end
end